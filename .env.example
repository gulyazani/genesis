# Telegram (BotFather). Never commit the real token.
BOT_TOKEN=
TELEGRAM_ADMIN_ID=
MINI_APP_URL=https://your-domain.example

# Checkout — Nizam'ın cüzdanı. USDT TRC-20 varsayılan.
CRYPTO_WALLET_ADDRESS=
CRYPTO_ASSET=USDT
CRYPTO_NETWORK=TRC-20
CRYPTO_WATCH_WINDOW_MIN=120

# Watcher. Local: mock açık. VPS'te WATCHER_MOCK=0 ve isteğe TronGrid anahtarı.
WATCHER_MOCK=1
TRONGRID_API_KEY=
WATCHER_INTERVAL_MS=20000

# Mini App tarayıcıda açılsın diye local'de 1. Prod'da 0 — initData zorunlu.
DEV_BYPASS_TELEGRAM=1

# İsteğe bağlı
# DATA_DIR=/app/data
# PORT=43127
